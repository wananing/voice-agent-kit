        "string",
        "null"
      ]
    },
    "user_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[cs][0-9]+$"
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
